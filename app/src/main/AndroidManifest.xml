<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Car App Library permissions. Only the two below are library permissions. -->
    <!-- ACCESS_SURFACE: AppManager.setSurfaceCallback (touch tester, visible/stable area). -->
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <!-- MAP_TEMPLATES: allows MapWithContentTemplate, the only way a surface becomes visible. POI category only. -->
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />

    <!-- CarHardwareManager on Android Auto (Car Hardware APIs docs). The user must also grant them. -->
    <uses-permission android:name="com.google.android.gms.permission.CAR_SPEED" />
    <uses-permission android:name="com.google.android.gms.permission.CAR_FUEL" />
    <uses-permission android:name="com.google.android.gms.permission.CAR_MILEAGE" />
    <!-- CarSensors location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 12+ lets users grant approximate location only; the system requires both entries to be declared. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Phone side: Wi-Fi band and link speed, network state. No INTERNET permission on purpose. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Package visibility (API 30+) for reading the Android Auto app version. -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
    </queries>

    <application
        android:name=".AutoScopeApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.AutoScope"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- Declares the app as a template and a media app for Android Auto (res/xml/automotive_app_desc.xml). -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Lowest Car App API level used: MapWithContentTemplate needs 7, TabTemplate 6. Lower hosts get fallbacks. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <service
            android:name=".car.AutoScopeCarService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <!-- POI category (CarAppService.CATEGORY_POI_APP). IOT is experimental, see KNOWN_LIMITATIONS.md. -->
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>

        <!-- Media entry point: a real Android Auto host launches sideloaded media apps ("Unknown sources")
             but denies sideloaded Car App Library apps (CAR.VALIDATOR "failed all other checks"). -->
        <service
            android:name=".media.AutoScopeMediaService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <activity
            android:name=".phone.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.reports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
