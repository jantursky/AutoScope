<?xml version="1.0" encoding="utf-8"?>
<!-- 40dp round ripple inside a 48dp touch target. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="4dp">
    <ripple android:color="@color/ripple_accent">
        <item android:id="@android:id/mask">
            <shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape>
        </item>
    </ripple>
</inset>
